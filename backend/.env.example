# Aimentra LMS — Environment Example
# Copy to .env and fill in values. Never commit real secrets.

MONGODB_URI=mongodb://localhost:27017/aimentra
JWT_ACCESS_SECRET=change_me_access
JWT_REFRESH_SECRET=change_me_refresh
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000
API_BASE_URL=http://localhost:5000

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

COOKIE_SECRET=change_me_cookie
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

VIDEO_TOKEN_SECRET=change_me_video
VIDEO_TOKEN_TTL_SECONDS=45

BREVO_API_KEY=
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
PAYMENT_GATEWAY_ENABLED=false
EMAIL_FROM=noreply@aimentra.com
SUPPORT_EMAIL=support@aimentra.com
EMAIL_FROM_NAME=Aimentra
